# Discord bot token (never commit real values)
DISCORD_BOT_TOKEN=

# Access control (Hermes-like). Fail closed unless ALLOW_ALL_USERS=true.
DISCORD_ALLOW_ALL_USERS=false
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_ROLES=
DISCORD_FREE_RESPONSE_CHANNELS=
DISCORD_REQUIRE_MENTION=true
DISCORD_HOME_CHANNEL=

# Backend: openai (default) | grok-bot (stub)
AGENT_BACKEND=openai

# OpenAI-compatible provider (xAI / OpenAI / OpenRouter / etc.)
API_BASE_URL=https://api.x.ai/v1
API_KEY=
MODEL=grok-2-latest

SYSTEM_PROMPT_FILE=SOUL.md
TEMPERATURE=0.7
MAX_TOKENS=1024
MEMORY_MAX_MESSAGES=20

RATE_LIMIT_PER_USER=5
RATE_LIMIT_WINDOW_MS=60000

# Optional web search (omit both = no tools)
# BRAVE_API_KEY=
# TAVILY_API_KEY=
