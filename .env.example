# Discord bot token (never commit real values)
DISCORD_BOT_TOKEN=

# Access control (team / personal). Fail closed unless ALLOW_ALL_USERS=true.
DISCORD_ALLOW_ALL_USERS=false
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_ROLES=
DISCORD_ALLOWED_GUILDS=
DISCORD_ALLOW_DMS=false
DISCORD_DM_ONLY=false
DISCORD_FREE_RESPONSE_CHANNELS=
DISCORD_REQUIRE_MENTION=true
DISCORD_HOME_CHANNEL=

# Backend: openai (Phase 1 default) | grok-bot (unofficial computer-gateway + bridge callback)
AGENT_BACKEND=openai

# OpenAI-compatible provider (required when AGENT_BACKEND=openai)
API_BASE_URL=https://api.x.ai/v1
API_KEY=
MODEL=grok-2-latest

# Grok Bot computer gateway (required when AGENT_BACKEND=grok-bot).
# Private LAN / Tailscale / SSH tunnel only — never expose :1340 to the internet.
# GROK_BOT_TOKEN is the bearer from that computer's gateway.json (treat like a password).
# GROK_BOT_GATEWAY_URL=http://grok-bot-host:1340
# GROK_BOT_TOKEN=
# GROK_BOT_AGENT_ID=
# GROK_BOT_TIMEOUT_MS=120000

# Bridge callback the Grok Bot agent POSTs to (required when AGENT_BACKEND=grok-bot).
# BRIDGE_PUBLIC_URL must be reachable from the Grok Bot computer (not localhost on that machine).
# BRIDGE_REPLY_TOKEN is a shared secret you create — treat like a password; do not log it.
# BRIDGE_HTTP_HOST=0.0.0.0
# Compose publishes host:container as ${BRIDGE_HTTP_PORT:-8788}:${BRIDGE_HTTP_PORT:-8788}
# BRIDGE_HTTP_PORT=8788
# BRIDGE_PUBLIC_URL=http://bridge-host:8788
# BRIDGE_REPLY_TOKEN=

# Neutral default; see examples/team-assistant and examples/gaming-helper
SYSTEM_PROMPT_FILE=SOUL.md
TEMPERATURE=0.7
MAX_TOKENS=1024
MEMORY_MAX_MESSAGES=20

RATE_LIMIT_PER_USER=5
RATE_LIMIT_WINDOW_MS=60000

# Optional web search for the OpenAI-compatible path (omit both = no tools)
# BRAVE_API_KEY=
# TAVILY_API_KEY=
